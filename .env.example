# ==========================================================================
# Variables de entorno de Transurfing. Copia este archivo a .env y rellénalo.
# En Fly.io se cargan como secretos:  fly secrets import < .env
# (o usa ./deploy.sh --setup  /  ./deploy.ps1 -Action setup)
# ==========================================================================

# --- LLM (necesario para los agentes y el chat) ---
# Gateway compatible con OpenAI (por defecto OpenCode Zen).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=qwen3.5-plus
# Lista opcional de modelos a mostrar (separa por coma). Si se define, no autodescubre.
LLM_MODELS=

# --- Groq (opcional: LLM alternativo y transcripción de voz) ---
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# --- URL pública (necesaria para el callback de GitHub OAuth) ---
# En Fly.io: https://<tu-app>.fly.dev
TAREAS_URL=

# --- GitHub OAuth (opcional: login / commits con GitHub) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Seguridad (opcional) ---
# Si se define, /api/* exige este token (salvo health y el callback OAuth).
API_AUTH_TOKEN=
# Orígenes permitidos por CORS (separa por coma) o * para todos.
CORS_ORIGINS=*
# Clave para cifrar secretos guardados (Fernet). Usa una cadena larga y aleatoria.
SECRET_KEY=

# --- Persistencia ---
# Backend de datos: json (por defecto) o sqlite.
STORAGE_BACKEND=json
# Directorio de datos. En Fly.io es el volumen montado en /data.
TAREAS_DATA_DIR=/data
# Ruta del SQLite (sólo si STORAGE_BACKEND=sqlite).
# DB_PATH=/data/tareas.db
